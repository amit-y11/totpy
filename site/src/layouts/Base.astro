---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { links } from '../lib/links';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Totpy — Open-source 2FA authenticator for Chrome',
  description = 'Free, open-source 2FA codes in your browser. Fill codes with one click, sync them end-to-end encrypted, no account needed.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const nav = [
  { href: '/#how', label: 'How it works' },
  { href: '/#sync', label: 'Sync' },
  { href: '/#features', label: 'Features' },
  { href: '/#security', label: 'Security' },
  { href: '/#faq', label: 'FAQ' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#08080b" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Totpy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>

    <header class="site-header" data-header>
      <div class="nav-pill">
        <a class="brand" href="/" aria-label="Totpy home">
          <Logo size={26} />
          <span>Totpy</span>
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <div class="nav-actions">
          <a class="nav-icon" href={links.repo} aria-label="Totpy on GitHub">
            <Icon name="github" size={19} />
          </a>
          <a class="btn btn-primary btn-sm" href={links.download}>
            Get Totpy
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/">
            <Logo size={26} />
            <span>Totpy</span>
          </a>
          <p>
            Free, open-source 2FA for Chrome.
            <br />
            This site has no cookies, trackers or analytics.
          </p>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <div>
            <h3>Product</h3>
            <a href="/#features">Features</a>
            <a href={links.download}>Download</a>
            <a href={links.releases}>Release notes</a>
          </div>
          <div>
            <h3>Trust</h3>
            <a href="/privacy">Privacy policy</a>
            <a href={links.securityDesign}>Security design</a>
            <a href={links.reportVulnerability}>Report a vulnerability</a>
          </div>
          <div>
            <h3>Community</h3>
            <a href={links.repo}>GitHub</a>
            <a href={links.contributing}>Contribute</a>
            <a href={links.license}>MIT License</a>
          </div>
        </nav>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} the Totpy contributors</span>
        <span class="mono">RFC 6238 · AES-256-GCM · MIT</span>
      </div>
      <div class="wordmark" aria-hidden="true">
        Totpy
      </div>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>('[data-header]');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: 16px;
    top: 16px;
    z-index: 300;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--lime);
    color: var(--lime-ink);
  }

  .site-header {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 0 12px;
    pointer-events: none;
  }

  .nav-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: min(1080px, 100%);
    padding: 7px 7px 7px 18px;
    border: 1px solid transparent;
    border-radius: 999px;
    pointer-events: auto;
    transition:
      background 0.35s,
      border-color 0.35s,
      box-shadow 0.35s;
  }

  .is-scrolled .nav-pill {
    border-color: var(--line);
    background: rgb(13 13 18 / 0.88);
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.7);
    backdrop-filter: saturate(1.4) blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand :global(svg) {
    border-radius: 7px;
  }

  .nav {
    display: flex;
    gap: 4px;
  }

  .nav a {
    padding: 8px 14px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 15px;
    text-decoration: none;
    transition:
      color 0.2s,
      background 0.2s;
  }

  .nav a:hover {
    background: rgb(255 255 255 / 0.06);
    color: var(--text);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--muted);
    transition:
      color 0.2s,
      background 0.2s;
  }

  .nav-icon:hover {
    background: rgb(255 255 255 / 0.06);
    color: var(--text);
  }

  .site-footer {
    position: relative;
    overflow: hidden;
    padding: 96px 0 0;
    border-top: 1px solid var(--line);
    background: var(--ink);
    font-size: 15px;
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    gap: 56px;
    flex-wrap: wrap;
  }

  .footer-brand p {
    margin-top: 18px;
    color: var(--muted);
  }

  .footer-links {
    display: flex;
    gap: 72px;
    flex-wrap: wrap;
  }

  .footer-links div {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-links h3 {
    margin-bottom: 4px;
    color: var(--dim);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--lime);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font-size: 13.5px;
  }

  .wordmark {
    margin: 32px 0 -0.24em;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.01) 80%);
    background-clip: text;
    color: transparent;
    font-size: clamp(120px, 27vw, 420px);
    font-weight: 800;
    letter-spacing: -0.07em;
    line-height: 0.8;
    text-align: center;
    user-select: none;
  }

  @media (max-width: 920px) {
    .nav {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .footer-links {
      gap: 40px;
    }
  }
</style>
