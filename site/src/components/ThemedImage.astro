---
// Shows the light or dark screenshot to match the visitor's color scheme.
// Both are optimized to WebP at build time; browsers only download the one they show.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  width: number;
  class?: string;
  eager?: boolean;
}

const { light, dark, alt, width, class: className, eager = false } = Astro.props;
const options = { width: width * 2, format: 'webp' as const, quality: 85 };
const [lightImg, darkImg] = await Promise.all([
  getImage({ src: light, ...options }),
  getImage({ src: dark, ...options }),
]);
const height = Math.round((light.height / light.width) * width);
---

<picture class={className}>
  <source srcset={darkImg.src} media="(prefers-color-scheme: dark)" type="image/webp" />
  <img
    src={lightImg.src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</picture>
