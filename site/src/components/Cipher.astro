---
// "What you see / what the cloud sees". motion.ts replaces the placeholders
// with real AES-256-GCM output, re-encrypted with a fresh throwaway key each period.
import { randomBytes } from 'node:crypto';
import { SAMPLE_ACCOUNTS } from '../lib/demo';
import Icon from './Icon.astro';

const placeholder = () => randomBytes(24).toString('base64').slice(0, 30);

const points = [
  {
    title: 'Chrome sync',
    text: 'Works the moment you install it in a signed-in Chrome profile.',
  },
  {
    title: 'Google Drive',
    text: 'Unlimited accounts in a hidden app folder, with version history.',
  },
  {
    title: 'Every device follows',
    text: 'New accounts, edits, deletions and password changes merge on their own.',
  },
];
---

<section class="paper section cipher" id="sync" data-cipher-section data-play>
  <div class="container">
    <div class="sec-head">
      <p class="eyebrow" data-reveal>
        End-to-end encrypted sync
      </p>
      <h2 class="display" data-reveal style="--d:1">
        What you see. <span class="serif">What the cloud sees.</span>
      </h2>
      <p class="lede" data-reveal style="--d:2">
        Your vault is encrypted on your device before it leaves. Chrome sync and Google Drive keep
        your computers in step, and only ever hold the column on the right.
      </p>
    </div>

    <div class="cipher-grid" data-reveal style="--d:2">
      <div class="card card-plain">
        <div class="card-head">
          <span>
            <span class="live-dot"></span> Your screen
          </span>
          <span class="mono">plaintext</span>
        </div>
        {SAMPLE_ACCOUNTS.map((acc) => (
          <div class="row">
            <span class="av" style={`--h:${acc.hue}`}>
              {acc.issuer[0]}
            </span>
            <span class="who">
              <b>{acc.issuer}</b>
              <small>{acc.account}</small>
            </span>
            <span class="code mono" data-code={acc.secret}>
              --- ---
            </span>
          </div>
        ))}
      </div>

      <div class="flow" aria-hidden="true">
        <div class="flow-line">
          {[0, 1, 2, 3, 4].map((i) => (
            <span class="packet" style={`--i:${i}`} />
          ))}
        </div>
        <div class="flow-badge">
          <Icon name="lock" size={18} />
          <span>AES-256-GCM</span>
          <small>on your device</small>
        </div>
      </div>

      <div class="card card-cloud">
        <div class="card-head">
          <span>
            <Icon name="sync" size={15} /> Chrome sync · Google Drive
          </span>
          <span class="mono">ciphertext</span>
        </div>
        {SAMPLE_ACCOUNTS.map((acc) => (
          <div class="row">
            <span class="lock-tile">
              <Icon name="lock" size={14} />
            </span>
            <span class="ct mono" data-cipher={`${acc.issuer}|${acc.account}`}>
              {placeholder()}
            </span>
          </div>
        ))}
      </div>
    </div>

    <p class="note mono" data-reveal>
      ↑ Real ciphertext, encrypted in your browser moments ago with a throwaway key. Totpy has no
      servers, so this is all anyone else ever stores.
    </p>

    <div class="points">
      {points.map((p, i) => (
        <div class="point" data-reveal style={`--d:${i}`}>
          <span class="point-num mono">0{i + 1}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cipher-grid {
    display: grid;
    grid-template-columns: 1fr 150px 1fr;
    align-items: center;
  }

  .card {
    overflow: hidden;
    border-radius: 22px;
  }

  .card-plain {
    border: 1px solid var(--paper-line);
    background: #fff;
    box-shadow: 0 30px 60px -40px rgb(19 19 23 / 0.35);
  }

  .card-cloud {
    background: var(--ink);
    color: #ededef;
    box-shadow: 0 40px 80px -40px rgb(19 19 23 / 0.7);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 22px;
    border-bottom: 1px solid var(--paper-line);
    color: var(--paper-muted);
    font-size: 13px;
    font-weight: 600;
  }

  .card-head > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .card-head .mono {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .card-cloud .card-head {
    border-color: rgb(255 255 255 / 0.08);
    color: #8a8a96;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 70px;
    padding: 0 22px;
  }

  .row + .row {
    border-top: 1px solid rgb(19 19 23 / 0.06);
  }

  .card-cloud .row + .row {
    border-color: rgb(255 255 255 / 0.05);
  }

  .av {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: hsl(var(--h) 70% 55% / 0.14);
    color: hsl(var(--h) 60% 38%);
    font-weight: 700;
  }

  .who {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .who b {
    font-size: 15px;
  }

  .who small {
    color: var(--paper-muted);
    font-size: 12.5px;
  }

  .code {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .lock-tile {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgb(201 246 95 / 0.1);
    color: var(--lime);
  }

  .ct {
    overflow: hidden;
    color: #b8f05a;
    font-size: 14.5px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    opacity: 0.9;
    mask-image: linear-gradient(90deg, #000 80%, transparent);
  }

  /* Flow between the cards */

  .flow {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
  }

  .flow-line {
    position: absolute;
    left: -2px;
    right: -2px;
    top: 50%;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--paper-line) 0 6px, transparent 6px 12px);
  }

  .packet {
    position: absolute;
    top: -3px;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--brand-deep);
    opacity: 0;
    animation: packet 2.6s linear infinite;
    animation-delay: calc(var(--i) * -0.52s);
    animation-play-state: paused;
  }

  .is-playing .packet {
    animation-play-state: running;
  }

  @keyframes packet {
    0% {
      left: 0;
      opacity: 0;
      background: var(--brand-deep);
      border-radius: 50%;
    }
    10% {
      opacity: 1;
    }
    50% {
      background: var(--brand-deep);
      border-radius: 50%;
    }
    52% {
      background: #8fc23a;
      border-radius: 2px;
    }
    90% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 8px);
      opacity: 0;
      background: #8fc23a;
      border-radius: 2px;
    }
  }

  .flow-badge {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 14px 12px;
    border: 1px solid var(--paper-line);
    border-radius: 16px;
    background: var(--paper);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: center;
  }

  .flow-badge :global(svg) {
    margin-bottom: 4px;
    color: var(--brand-deep);
  }

  .flow-badge small {
    color: var(--paper-muted);
    font-size: 10px;
    font-weight: 500;
  }

  .note {
    margin-top: 28px;
    margin-left: auto;
    max-width: 520px;
    color: var(--paper-muted);
    font-size: 12.5px;
    line-height: 1.6;
    text-align: right;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 96px;
    border-top: 1px solid var(--paper-line);
  }

  .point {
    padding: 32px 32px 0 0;
  }

  .point-num {
    color: var(--brand-deep);
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .point h3 {
    margin-top: 14px;
    font-size: 24px;
  }

  .point p {
    margin-top: 10px;
    color: var(--paper-muted);
  }

  @media (max-width: 900px) {
    .cipher-grid {
      grid-template-columns: 1fr;
    }

    .flow {
      height: 120px;
    }

    .flow-line {
      left: 50%;
      right: auto;
      top: -2px;
      bottom: -2px;
      width: 2px;
      height: auto;
      background: repeating-linear-gradient(180deg, var(--paper-line) 0 6px, transparent 6px 12px);
    }

    .packet {
      left: -3px;
      animation-name: packet-v;
    }

    .note {
      text-align: left;
      margin-left: 0;
    }

    .points {
      grid-template-columns: 1fr;
    }
  }

  @keyframes packet-v {
    0% {
      top: 0;
      opacity: 0;
    }
    10%,
    90% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 8px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .packet {
      display: none;
    }
  }
</style>
