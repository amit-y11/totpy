---
import popupDark from '../assets/popup-dark.png';
import popupLight from '../assets/popup-light.png';
import settingsDark from '../assets/settings-dark.png';
import settingsLight from '../assets/settings-light.png';
import Icon from '../components/Icon.astro';
import ThemedImage from '../components/ThemedImage.astro';
import Base from '../layouts/Base.astro';
import { links } from '../lib/links';

const trust = [
  { icon: 'lock', label: 'End-to-end encrypted' },
  { icon: 'server', label: 'No servers, no account' },
  { icon: 'code', label: 'Open source, MIT' },
  { icon: 'eyeOff', label: 'No tracking, ever' },
] as const;

const features = [
  {
    icon: 'cursor',
    title: 'One-click fill',
    text: 'Fill the code straight into the page, or right-click any field and choose Insert 2FA code.',
  },
  {
    icon: 'target',
    title: 'Knows the site',
    text: 'Totpy suggests the right account for the page you are on, so you never hunt through a list.',
  },
  {
    icon: 'scan',
    title: 'Scan from the screen',
    text: 'Set up 2FA without your phone. Scan the QR code on the page, upload an image or paste a link.',
  },
  {
    icon: 'import',
    title: 'Bring your accounts',
    text: 'Import everything from Google Authenticator in one go, or any list of otpauth:// links.',
  },
  {
    icon: 'sync',
    title: 'Encrypted sync',
    text: 'Keep every computer in step through Chrome sync or Google Drive. They only ever see ciphertext.',
  },
  {
    icon: 'key',
    title: 'Recovery code',
    text: 'Forgot your master password? Your recovery code gets you back in. Nobody else can.',
  },
  {
    icon: 'history',
    title: 'Automatic copies',
    text: 'An encrypted snapshot every day for a week, so a mistaken delete is one click to undo.',
  },
  {
    icon: 'clock',
    title: 'Clock check',
    text: 'Codes depend on the time. Totpy warns you when your clock is off before a site rejects you.',
  },
] as const;

const steps = [
  {
    title: 'Create a master password',
    text: 'Totpy encrypts everything with it and shows a recovery code once. Keep that code somewhere safe.',
  },
  {
    title: 'Add your accounts',
    text: 'On any 2FA setup page, open Totpy and scan the QR code on screen. Or import from Google Authenticator.',
  },
  {
    title: 'Sign in with one click',
    text: 'When a site asks for a code, click Fill. Totpy already knows which account you need.',
  },
];

const security = [
  'AES-256-GCM encryption with a random 256-bit vault key',
  'PBKDF2-SHA-256 with 600,000 iterations for your password',
  'Tamper-proof sync: forged or downgraded copies are rejected',
  'Locks automatically, and whenever Chrome closes',
  'No access to websites until you click Fill or Insert',
  'Readable builds: bundled, never minified',
];

const faqs = [
  {
    q: 'Is Totpy really free?',
    a: 'Yes. Every feature is free with no account limits, and the code is MIT licensed. There is no paid tier.',
  },
  {
    q: 'What if I forget my master password?',
    a: 'Click “Forgot password?”, enter your recovery code and choose a new password. If you lose both, nobody can decrypt your codes, including us. Keep the backup codes websites give you when you turn on 2FA.',
  },
  {
    q: 'Can Totpy see my codes?',
    a: 'No. Totpy has no servers. Codes are generated on your device, and sync providers only store an encrypted file that only your password or recovery code can open.',
  },
  {
    q: 'Is it safe to keep 2FA codes in my browser?',
    a: 'Totpy encrypts your codes and locks itself, but it shares a device with your passwords. For your most important accounts, a hardware security key is stronger still. Our security design explains the trade-offs openly.',
  },
  {
    q: 'How do I move from Google Authenticator?',
    a: 'In Google Authenticator choose Transfer accounts → Export accounts, take a photo of the QR code, then click + → Upload QR in Totpy. All accounts come across at once.',
  },
  {
    q: 'Which browsers are supported?',
    a: 'Totpy is built and tested for Google Chrome. Other Chromium browsers should work, but Google Drive sync needs Chrome. Firefox is on the roadmap.',
  },
];
---

<Base>
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <a class="pill" href={links.releases}>
          <span class="pill-dot"></span> Free &amp; open source · v1.0 is out
        </a>
        <h1>Your 2FA codes, right where you sign&nbsp;in.</h1>
        <p class="lead">
          Totpy is a free, open-source authenticator for Chrome. Fill codes with one click, sync
          them end-to-end encrypted, and stop reaching for your phone.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={links.download}>
            <Icon name="download" /> Download for Chrome
          </a>
          <a class="btn" href={links.repo}>
            <Icon name="github" /> View on GitHub
          </a>
        </div>
        <p class="hero-note">Chrome Web Store listing coming soon · No account needed</p>
      </div>

      <div class="hero-visual">
        <div class="browser" aria-hidden="true">
          <div class="browser-bar">
            <span class="dots">
              <i></i>
              <i></i>
              <i></i>
            </span>
            <span class="address">
              <Icon name="lock" size={12} /> github.com/sessions/two-factor
            </span>
            <span class="ext-icon"></span>
          </div>
          <div class="browser-page">
            <div class="fake-title"></div>
            <div class="fake-line"></div>
            <div class="fake-input">
              <span class="caret"></span>
            </div>
            <div class="fake-button"></div>
          </div>
        </div>
        <ThemedImage
          class="popup-shot"
          light={popupLight}
          dark={popupDark}
          width={300}
          eager
          alt="The Totpy popup suggesting the GitHub account on github.com, with a Fill button and live codes"
        />
      </div>
    </div>
  </section>

  <section class="trust" aria-label="Highlights">
    <div class="container trust-inner">
      {trust.map((item) => (
        <div class="trust-item">
          <Icon name={item.icon} size={20} />
          <span>{item.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">Features</p>
        <h2>Everything you expect. Nothing you don't.</h2>
        <p>
          The convenience of a browser extension with the care of a password manager. No ads, no
          upsells, no data collection.
        </p>
      </div>
      <div class="features">
        {features.map((f) => (
          <article class="feature">
            <span class="feature-icon">
              <Icon name={f.icon} size={22} />
            </span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft" id="how">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">How it works</p>
        <h2>Set up in a minute.</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step-num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="sync">
    <div class="container split">
      <div class="split-copy">
        <p class="eyebrow">Sync</p>
        <h2>On every computer. Readable on none of them but yours.</h2>
        <p>
          Your vault is encrypted on your device before it goes anywhere. Changes merge across
          computers on their own, including deletions and password changes.
        </p>
        <ul class="checks">
          <li>
            <Icon name="check" size={18} />{' '}
            <span>
              <strong>Chrome sync</strong>: works out of the box with your Chrome profile
            </span>
          </li>
          <li>
            <Icon name="check" size={18} />{' '}
            <span>
              <strong>Google Drive</strong>: unlimited accounts and version history
            </span>
          </li>
          <li>
            <Icon name="check" size={18} />{' '}
            <span>Change your password once; every device follows</span>
          </li>
        </ul>
      </div>
      <ThemedImage
        class="settings-shot"
        light={settingsLight}
        dark={settingsDark}
        width={560}
        alt="Totpy settings with Chrome sync turned on, Google Drive, auto-lock and the recovery code"
      />
    </div>
  </section>

  <section class="section section-soft" id="security">
    <div class="container split reverse">
      <div class="split-copy">
        <p class="eyebrow">Security</p>
        <h2>Built like a password manager.</h2>
        <p>
          Totpy is open source so you don't have to take our word for any of this. The full design
          and threat model are public, and so is every line of code that ships.
        </p>
        <div class="cta">
          <a class="btn" href={links.securityDesign}>
            Read the security design <Icon name="arrow" />
          </a>
        </div>
      </div>
      <ul class="security-list">
        {security.map((item) => (
          <li>
            <span class="shield">
              <Icon name="shield" size={18} />
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container faq-wrap">
      <div class="section-head center">
        <p class="eyebrow">FAQ</p>
        <h2>Questions, answered.</h2>
      </div>
      <div class="faq">
        {faqs.map((item) => (
          <details>
            <summary>
              {item.q}
              <Icon name="chevron" size={18} />
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section final">
    <div class="container">
      <div class="final-card">
        <h2>Two-factor, without the friction.</h2>
        <p>Free forever. Open source. Your codes stay yours.</p>
        <div class="cta center">
          <a class="btn btn-primary" href={links.download}>
            <Icon name="download" /> Download for Chrome
          </a>
          <a class="btn" href={links.contributing}>
            <Icon name="github" /> Contribute
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */

  .hero {
    position: relative;
    overflow: hidden;
    padding: 88px 0 96px;
  }

  .hero-glow {
    position: absolute;
    inset: -30% -10% auto;
    height: 760px;
    background:
      radial-gradient(40% 50% at 70% 40%, var(--accent-glow), transparent 70%),
      radial-gradient(
        30% 40% at 20% 20%,
        color-mix(in srgb, var(--accent) 10%, transparent),
        transparent 70%
      );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: 56px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-soft);
    font-size: 13px;
    font-weight: 550;
    text-decoration: none;
  }

  .pill:hover {
    border-color: var(--accent);
  }

  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 20%, transparent);
  }

  h1 {
    margin-top: 24px;
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .lead {
    max-width: 520px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 19px;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .cta.center {
    justify-content: center;
  }

  .hero-note {
    margin-top: 16px;
    color: var(--muted);
    font-size: 13.5px;
  }

  .hero-visual {
    position: relative;
    padding: 0 0 48px;
  }

  .browser {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
  }

  .address {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 8px;
    background: var(--surface);
    color: var(--muted);
    font-size: 12px;
  }

  .ext-icon {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: url('/favicon.svg') center / cover;
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .browser-page {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 380px;
    padding: 48px 40px;
  }

  .fake-title,
  .fake-line,
  .fake-input,
  .fake-button {
    border-radius: 8px;
    background: var(--bg-soft);
  }

  .fake-title {
    width: 55%;
    height: 22px;
  }

  .fake-line {
    width: 75%;
    height: 12px;
  }

  .fake-input {
    position: relative;
    width: 62%;
    height: 44px;
    margin-top: 18px;
    border: 2px solid var(--accent);
    background: var(--surface);
  }

  .caret {
    position: absolute;
    top: 11px;
    left: 14px;
    width: 2px;
    height: 18px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .fake-button {
    width: 30%;
    height: 40px;
    background: color-mix(in srgb, var(--accent) 22%, var(--bg-soft));
  }

  .hero-visual :global(.popup-shot img) {
    position: absolute;
    top: 52px;
    right: -12px;
    width: 300px;
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
  }

  /* Trust strip */

  .trust {
    border-block: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .trust-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding: 22px 0;
  }

  .trust-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--text-soft);
    font-size: 15px;
    font-weight: 550;
  }

  .trust-item :global(svg) {
    color: var(--accent);
  }

  /* Features */

  .features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .feature {
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .feature:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .feature-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 18px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .feature h3 {
    font-size: 17px;
  }

  .feature p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
  }

  /* Steps */

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step {
    position: relative;
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
  }

  @media (prefers-color-scheme: dark) {
    .step-num {
      color: #0c0c0e;
    }
  }

  .step h3 {
    font-size: 19px;
  }

  .step p {
    margin-top: 10px;
    color: var(--muted);
  }

  /* Split sections */

  .split {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: 72px;
  }

  .split.reverse {
    grid-template-columns: 1fr 1fr;
  }

  .split-copy h2 {
    font-size: clamp(30px, 4vw, 40px);
  }

  .split-copy > p:not(.eyebrow) {
    margin-top: 18px;
    color: var(--muted);
    font-size: 18px;
  }

  .checks {
    display: grid;
    gap: 14px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-soft);
  }

  .checks li {
    display: flex;
    gap: 12px;
  }

  .checks :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--success);
  }

  .split :global(.settings-shot img) {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .security-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .security-list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-soft);
    font-weight: 500;
  }

  .shield {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  /* FAQ */

  .faq-wrap {
    max-width: 760px;
  }

  .faq {
    display: grid;
    gap: 12px;
  }

  details {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    font-size: 17px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(svg) {
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 0.2s;
  }

  details[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  details p {
    padding: 0 22px 22px;
    color: var(--muted);
  }

  /* Final CTA */

  .final {
    padding-top: 24px;
  }

  .final-card {
    padding: 72px 32px;
    border: 1px solid var(--border);
    border-radius: 28px;
    background:
      radial-gradient(60% 80% at 50% 0%, var(--accent-glow), transparent 70%), var(--bg-soft);
    text-align: center;
  }

  .final-card h2 {
    font-size: clamp(30px, 4.5vw, 46px);
  }

  .final-card p {
    margin-top: 14px;
    color: var(--muted);
    font-size: 18px;
  }

  /* Responsive */

  @media (max-width: 1000px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 56px;
    }

    .hero-inner,
    .split,
    .split.reverse {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .hero-visual {
      max-width: 560px;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .trust-inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .trust-item {
      justify-content: flex-start;
    }
  }

  @media (max-width: 560px) {
    .features {
      grid-template-columns: 1fr;
    }

    .browser-page {
      height: 300px;
      padding: 32px 24px;
    }

    .hero-visual :global(.popup-shot img) {
      top: 40px;
      right: -8px;
      width: 220px;
    }

    .cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
