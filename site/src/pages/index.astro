---
import Bento from '../components/Bento.astro';
import Cipher from '../components/Cipher.astro';
import Faq from '../components/Faq.astro';
import Handoff from '../components/Handoff.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import LiveDial from '../components/LiveDial.astro';
import Manifesto from '../components/Manifesto.astro';
import Spec from '../components/Spec.astro';
import Base from '../layouts/Base.astro';
import { DEMO } from '../lib/demo';
import { links } from '../lib/links';
---

<Base>
  <Hero />
  <Handoff />
  <Cipher />
  <Bento />
  <Spec />
  <Manifesto />
  <Faq />

  <section class="final">
    <div class="final-glow" aria-hidden="true"></div>
    <div class="container final-inner">
      <div class="final-dial" data-reveal>
        <LiveDial id="final" secret={DEMO.secret} variant="mini" />
      </div>
      <h2 class="display" data-reveal style="--d:1">
        This code expires in{' '}
        <span class="secs">
          <span data-live-seconds>30</span>s
        </span>
        .<br />
        <span class="serif">Totpy doesn’t.</span>
      </h2>
      <p class="lede" data-reveal style="--d:2">
        Free, open source and yours to keep. Install it in under a minute.
      </p>
      <div class="final-cta" data-reveal style="--d:3">
        <a class="btn btn-primary" href={links.download}>
          <Icon name="download" /> Download for Chrome
        </a>
        <a class="btn" href={links.contributing}>
          <Icon name="github" /> Contribute
        </a>
      </div>
      <p class="final-note mono" data-reveal style="--d:4">
        Chrome Web Store listing coming soon
      </p>
    </div>
  </section>
</Base>

<script>
  import '../scripts/clock';
  import '../scripts/motion';
</script>

<style>
  .final {
    position: relative;
    overflow: hidden;
    padding: 160px 0 150px;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .final-glow {
    position: absolute;
    left: 50%;
    top: 30%;
    width: 1100px;
    height: 700px;
    background: radial-gradient(closest-side, rgb(91 91 214 / 0.3), transparent);
    transform: translateX(-50%);
  }

  .final-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }

  .final-dial {
    width: 220px;
    margin-bottom: 18px;
  }

  .secs {
    display: inline-block;
    min-width: 2.2ch;
    color: var(--lime);
    font-family: var(--mono);
    font-size: 0.86em;
    font-weight: 600;
    letter-spacing: -0.04em;
    text-align: left;
  }

  .final .lede {
    margin: 0 auto;
  }

  .final-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 10px;
  }

  .final-note {
    color: var(--dim);
    font-size: 12.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
